# Copy this file to ".env" and fill in your real values.
# Never commit .env to version control.

# Required: get a free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# LiteLLM model identifier. Format: <provider>/<model>.
# llama3-70b-8192 was retired by Groq; the recommended replacement is below.
# Other options: groq/llama-3.1-8b-instant (cheaper), groq/llama-3.1-70b-versatile
LITELLM_MODEL=groq/llama-3.3-70b-versatile

# Local embedding model (downloaded the first time it runs).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Storage paths (relative to project root)
CHROMA_DB_PATH=./data/processed/chroma
MEMORY_DB_PATH=./data/processed/memory.db
RAW_DATA_PATH=./data/raw

# Crawler settings
NED_BASE_URL=https://www.neduet.edu.pk/
MAX_CRAWL_PAGES=30

# Retrieval settings
TOP_K=8
