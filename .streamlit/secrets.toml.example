# Streamlit Community Cloud secrets template
# ============================================
# When you deploy on https://share.streamlit.io, paste the contents below
# (with your real key) into the "Secrets" box of your app's settings.
# Streamlit Cloud will expose every value here as both st.secrets[...] and
# as an environment variable, which is what our config.py already reads.
#
# Do NOT commit the real .streamlit/secrets.toml file — it is gitignored.

GROQ_API_KEY = "gsk_REPLACE_WITH_YOUR_REAL_KEY"
LITELLM_MODEL = "groq/llama-3.3-70b-versatile"
EMBEDDING_MODEL = "sentence-transformers/all-MiniLM-L6-v2"
CHROMA_DB_PATH = "./data/processed/chroma"
MEMORY_DB_PATH = "./data/processed/memory.db"
RAW_DATA_PATH = "./data/raw"
NED_BASE_URL = "https://www.neduet.edu.pk/"
MAX_CRAWL_PAGES = 30
TOP_K = 8
